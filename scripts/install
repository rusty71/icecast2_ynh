#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

# The answers to a password question are not kept in the settings of the
# app, so the password is stored explicitly: the upgrade needs it to write
# the configuration file.
ynh_app_setting_set --key=password --value="$password"
expose_port="${expose_port:-false}"
bind_address="$(_icecast_bind_address)"

ynh_app_setting_set --key=expose_port --value="$expose_port"
#=================================================
# APP "BUILD" (DEPLOYING SOURCES, VENV, COMPILING ETC)
#=================================================

ynh_script_progression "Preparing the mime types..."

_icecast_prepare_mime_types

ynh_script_progression "Generating the fallback streams..."

_icecast_make_fallbacks

#=================================================
# APP CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

mkdir -p "/var/log/$app"
chown "$app:" "/var/log/$app"

ynh_config_add --template="icecast.xml" --destination="/etc/icecast2/icecast.xml"

chmod 400 "/etc/icecast2/icecast.xml"
chown "$app:$app" "/etc/icecast2/icecast.xml"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

_icecast_disable_debian_service

_icecast_firewall

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Streaming server (MP3 and lossless FLAC)" --log="/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --log_path="systemd"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
