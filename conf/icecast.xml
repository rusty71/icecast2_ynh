<?xml version="1.0" encoding="UTF-8"?>
<!--
    Icecast configuration for the Mopidy + Qobuz stack (YunoHost package).

    Mounts:
      /low.mp3   - MP3, 128 kbps, 48 kHz stereo (low bandwidth / mobile)
      /high.ogg  - Ogg FLAC, lossless up to 24-bit/96 kHz (high resolution)

    The "source" user (source-password below) is what the Mopidy publisher
    authenticates as when it publishes to the mounts.  Listeners are public.
-->
<icecast>
    <location>YunoHost</location>
    <admin>admin@__DOMAIN__</admin>
    <hostname>__DOMAIN__</hostname>

    <listen-socket>
        <port>__PORT__</port>
        <!-- 127.0.0.1: the streams are only reachable through the nginx
             reverse proxy.  0.0.0.0: the port is open as well, for listeners
             that connect directly (see the "expose_port" setting). -->
        <bind-address>__BIND_ADDRESS__</bind-address>
    </listen-socket>

    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
    </http-headers>

    <limits>
        <clients>50</clients>
        <sources>10</sources>
        <!-- Keep the mount buffer big enough for the lossless stream
             (~400 kB/s), otherwise Icecast drops listeners that fall a
             little behind. -->
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>32768</burst-size>
    </limits>

    <authentication>
        <!-- Sources (the Mopidy publisher) log in with username 'source'. -->
        <source-password>__PASSWORD__</source-password>
        <relay-password>__PASSWORD__</relay-password>

        <!-- Admin panel: https://your.domain/icecast/ -->
        <admin-user>__ADMIN__</admin-user>
        <admin-password>__PASSWORD__</admin-password>
    </authentication>

    <fileserve>1</fileserve>

    <!--
        Icecast's own mime type table maps .ogg to "audio/ogg", but the
        publisher announces the Ogg stream as "application/ogg".  Icecast
        only hands a mount over to a fallback stream when the content types
        match, so without this the listeners would get stuck on the
        fallback instead of the live stream.  The file is generated at
        install time from the system mime types.
    -->
    <mime-types>/etc/icecast2/mime.types.ynh</mime-types>

    <paths>
        <logdir>/var/log/__APP__</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <pidfile>/var/run/__APP__/icecast.pid</pidfile>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
        <logsize>100000</logsize>
    </logging>

    <!-- Low resolution stream: 128 kbps MP3. -->
    <mount type="normal">
        <mount-name>/low.mp3</mount-name>
        <public>1</public>
        <charset>UTF-8</charset>
        <!-- Keep the mount alive (and silent) when Mopidy is not playing. -->
        <fallback-mount>/silence.mp3</fallback-mount>
        <fallback-override>1</fallback-override>
    </mount>

    <!-- High resolution stream: lossless Ogg FLAC (up to 24-bit/96 kHz). -->
    <mount type="normal">
        <mount-name>/high.ogg</mount-name>
        <public>1</public>
        <charset>UTF-8</charset>
        <!-- Fallback must have the same container type as the live stream. -->
        <fallback-mount>/silence.ogg</fallback-mount>
        <fallback-override>1</fallback-override>
    </mount>

</icecast>
