#!/bin/bash

# The restore and backup scripts can be run from a different directory (the
# restore runs from a work directory), so the common helpers are looked up
# where they are.
_common_script="$(dirname "$0")/_common.sh"
if [ ! -f "$_common_script" ]; then
    _common_script="/etc/yunohost/apps/$app/scripts/_common.sh"
fi
source "$_common_script"
source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."

#=================================================
# SYSTEM CONFIGURATION
#=================================================

ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"

ynh_backup "/etc/systemd/system/$app.service"

ynh_backup "/etc/icecast2/icecast.xml"

ynh_backup "/etc/icecast2/mime.types.ynh"

#=================================================
# END OF SCRIPT
#=================================================

ynh_print_info "Backup script completed for $app. (YunoHost will then actually copy those files to the archive)."
